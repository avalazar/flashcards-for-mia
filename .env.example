# Neon pooled connection string (Console -> Connect -> Pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Random secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me

# Set to "production" on Render so the session cookie is marked Secure.
NODE_ENV=development
PORT=3000
